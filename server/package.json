{
  "name": "meter-tracker-server",
  "version": "1.0.0",
  "description": "Self-hosted sync server for the Meter Tracker PWA (Phase 2).",
  "type": "module",
  "main": "src/server.ts",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "multer": "^2.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  }
}
